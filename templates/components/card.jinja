{# Card component - renders a Brutality card from Verifiable Credential format #}
{% macro render_card(vc, is_reverse=False, showcase=False) %}
{# Extract card data from credentialSubject #}
{% set card = vc.credentialSubject %}
{# Construct proper static URL for card image #}
{% set card_image_path = card.cardImages.large.lstrip('/') %}
{% set card_image_url = url_for('static', filename=card_image_path) %}
<div class="card {% if card.cardTypes %}{{ card.cardTypes | join(' ') | lower }}{% endif %} interactive {% if is_reverse %}reverse-holo{% endif %} {% if showcase %}showcase{% endif %}"
     data-id="{{ card.cardId }}"
     data-number="{{ card.cardNumber | lower }}"
     data-set="{{ card.cardSet | lower }}"
     data-subtypes="{{ card.cardSubtypes | join(' ') | lower if card.cardSubtypes else '' }}"
     data-supertype="{{ card.cardSupertype | lower }}"
     data-rarity="{{ card.cardRarity | lower }}"
     {% if card.cardTypes %}data-types="{{ card.cardTypes | join(' ') | lower }}"{% endif %}>
    
    <div class="card__translater">
        <div class="card__rotator">
            <img class="card__back" 
                 src="{{ url_for('static', filename='img/cards_back.png') }}" 
                 alt="Brutality Card Back" 
                 loading="lazy"
                 width="660"
                 height="921" />
            
            <div class="card__front" style="--card-image: url('{{ card_image_url }}');">
                <div class="card__image"></div>
                <div class="card__shine"></div>
                <div class="card__glare"></div>
            </div>
        </div>
    </div>
</div>
{% endmacro %}

