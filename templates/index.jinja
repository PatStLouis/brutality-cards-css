{% extends "base.jinja" %}
{% from "components/card.jinja" import render_card %}

{% block content %}
<div class="brutal-container">
    <!-- Animated Background -->
    <div class="brutal-bg">
        <div class="scanlines"></div>
    </div>

    <!-- Header Section -->
    <header class="brutal-header">
        <div class="social-links">
            <a href="https://twitch.tv/brutalitypodcast" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Twitch">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/></svg>
            </a>
            <a href="https://youtube.com/@brutalitypodcast" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="YouTube">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://discord.gg/brutalitypodcast" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Discord">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </a>
        </div>
        <div class="logo-container">
            <img src="{{ url_for('static', filename='img/brutality-logo.png') }}" alt="Brutality Podcast" class="brutality-logo">
        </div>
        <h1 class="brutal-title">BRUTALITY CARDS</h1>
        <p class="brutal-subtitle">CSS Effects by @simeydotme</p>
        <div class="brutal-tagline">HOVER TO UNLEASH THE BRUTAL HOLOGRAPHIC EFFECTS!</div>
    </header>

    <!-- Search and Filter Controls -->
    <div class="controls-section">
        <div class="search-container">
            <input type="text" id="cardSearch" placeholder="SEARCH CARDS..." class="brutal-search">
        </div>
        <div class="filter-buttons">
            <button class="filter-btn active" data-filter="all">ALL</button>
            <button class="filter-btn" data-filter="basic">BASIC</button>
            <button class="filter-btn" data-filter="reverse">REVERSE</button>
            <button class="filter-btn" data-filter="holo">HOLO</button>
            <button class="filter-btn" data-filter="cosmic">COSMIC</button>
            <button class="filter-btn" data-filter="amazing">AMAZING</button>
            <button class="filter-btn" data-filter="rainbow">RAINBOW</button>
            <button class="filter-btn" data-filter="gold">GOLD</button>
        </div>
    </div>

    <!-- Card Sections -->
    <main class="cards-main">
        {% if cards and cards|length > 0 %}
        <section class="card-section showcase-section" data-category="showcase">
            <h2 class="section-title">FEATURED BRUTALITY</h2>
            <div class="showcase-card">
            {{ render_card(cards[0], showcase=True) }}
        </div>
        </section>
        {% endif %}

        <section class="card-section" data-category="basic">
            <h2 class="section-title">BASIC BRUTALITY</h2>
            <p class="section-description">
                All cards respond with <mark>aggressive 3D rotation</mark> tracking your cursor.<br /> 
                Even the basic cards hit you with a <mark>brutal glare effect</mark> that follows your every move.
            </p>
            <div class="card-row">
        {% for card in cards[1:4] %}
            {{ render_card(card) }}
        {% endfor %}
            </div>
    </section>

        <section class="card-section" data-category="reverse">
            <h2 class="section-title">REVERSE HOLO ASSAULT</h2>
            <p class="section-description">
                Reverse holo cards unleash <mark>inverted brutality</mark> with foil backgrounds that rage beneath the surface.
            </p>
            <div class="card-row">
        {% for i in [4, 5, 6, 70, 71, 72, 73, 74, 75] %}
            {% if i < cards|length %}
                {{ render_card(cards[i], is_reverse=True) }}
            {% endif %}
        {% endfor %}
            </div>
    </section>

        <section class="card-section" data-category="holo">
            <h2 class="section-title">HOLO DEVASTATION</h2>
            <p class="section-description">
                Rare holos crush you with <mark>vertical beam attacks</mark> of pure holographic energy.
            </p>
            <div class="card-row">
        {% for card in cards[7:13] %}
            {{ render_card(card) }}
        {% endfor %}
            </div>
    </section>

        <section class="card-section" data-category="cosmic">
            <h2 class="section-title">COSMIC ANNIHILATION</h2>
            <p class="section-description">
                Galaxy effects with <mark>gradient rainbow set to color-dodge &amp; color-burn</mark>.
            </p>
            <div class="card-row">
        {% for card in cards[13:16] %}
            {{ render_card(card) }}
        {% endfor %}
            </div>
    </section>

        <section class="card-section" data-category="amazing">
            <h2 class="section-title">AMAZING CARNAGE</h2>
            <p class="section-description">
                Amazing Rare cards have a <mark>very unique shiny foil</mark> that extends past the frame.
            </p>
            <div class="card-row">
        {% for card in cards[76:85] %}
            {{ render_card(card) }}
        {% endfor %}
            </div>
    </section>

        <section class="card-section" data-category="rainbow">
            <h2 class="section-title">RAINBOW OBLITERATION</h2>
            <p class="section-description">
                The Rainbow Rare is a <mark>super glittery effect on top of pastel gradients</mark>.
            </p>
            <div class="card-row">
                {% for card in cards[52:58] %}
            {{ render_card(card) }}
        {% endfor %}
            </div>
    </section>

        <section class="card-section" data-category="gold">
            <h2 class="section-title">BLOOD GOLD SUPREMACY</h2>
            <p class="section-description">
                <mark>GOLD!</mark> Two glitter layers sliding in opposite directions for shimmering effects.
            </p>
            <div class="card-row">
                {% for card in cards[58:64] %}
            {{ render_card(card) }}
        {% endfor %}
            </div>
    </section>
    </main>

    <!-- Back to Top -->
    <div class="back-to-top">
        <button id="backToTop" class="back-btn">⬆ BACK TO TOP</button>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Search functionality
    const searchInput = document.getElementById('cardSearch');
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cardSections = document.querySelectorAll('.card-section');
    
    searchInput.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        cardSections.forEach(section => {
            const cards = section.querySelectorAll('.card');
            let visibleCount = 0;
            
            cards.forEach(card => {
                const cardName = card.querySelector('.card__name')?.textContent.toLowerCase() || '';
                const cardType = card.querySelector('.card__type')?.textContent.toLowerCase() || '';
                
                if (cardName.includes(searchTerm) || cardType.includes(searchTerm)) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            section.style.display = visibleCount > 0 ? 'block' : 'none';
        });
    });
    
    // Filter functionality
    filterButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            filterButtons.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            
            const filter = this.dataset.filter;
            cardSections.forEach(section => {
                if (filter === 'all' || section.dataset.category.includes(filter)) {
                    section.style.display = 'block';
                } else {
                    section.style.display = 'none';
                }
            });
        });
    });
    
    // Back to top
    document.getElementById('backToTop').addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
});
</script>
{% endblock %}

{% block footer %}
<footer style="margin-top: 60px; padding: 40px 20px; text-align: center; border-top: 2px solid var(--brutal-red, #8B0000); background: rgba(10, 10, 10, 0.8);">
    <p style="font-size: 0.9em; color: #999; margin-bottom: 10px;">
        Holographic CSS effects based on 
        <a href="https://github.com/simeydotme/pokemon-cards-css" style="color: #8B0000;">pokemon-cards-css</a> 
        by <a href="https://twitter.com/simeydotme" style="color: #8B0000;">@simeydotme</a> 
        (GPL-3.0 License)
    </p>
    <p style="font-size: 0.85em; color: #666;">
        © 2024 Brutality Podcast. This is free software licensed under GPL-3.0.
    </p>
</footer>
{% endblock %}

{% block scripts %}
<script src="{{ url_for('static', filename='js/cards.js') }}"></script>
{% endblock %}